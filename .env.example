# KBS School ERP settings for the live server.
# Copy this file to .env and fill it in. Never share .env or put it on GitHub.

# Your web address, without https:// (a domain you own, or a free one such as kbsschool.duckdns.org)
DOMAIN=fees.example.in

# Real school: no demo data, no demo logins.
DEMO_MODE=off

# The first admin account, created the first time the app starts.
# After logging in, change the password from the menu. You can then delete these two lines.
ADMIN_NAME=School Admin
ADMIN_EMAIL=admin@example.in
ADMIN_PASSWORD=change-this-password

# ---- Optional ---------------------------------------------------------------

# Online fee payments with Razorpay (otherwise the test gateway is used: no real money).
# RAZORPAY_KEY_ID=rzp_live_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=xxx

# Automatic WhatsApp receipts (WhatsApp Business Cloud API).
# WHATSAPP_TOKEN=xxx
# WHATSAPP_PHONE_NUMBER_ID=xxx
# WHATSAPP_TEMPLATE_NAME=fee_receipt

# KBS AI Assistant on Claude (otherwise the built-in assistant answers).
# ANTHROPIC_API_KEY=sk-ant-xxx

# Off-site copies of the daily backup (Oracle Object Storage, Cloudflare R2, Backblaze B2 or AWS S3).
# BACKUP_S3_ENDPOINT=https://<namespace>.compat.objectstorage.ap-mumbai-1.oraclecloud.com
# BACKUP_S3_REGION=ap-mumbai-1
# BACKUP_S3_BUCKET=kbs-backups
# BACKUP_S3_ACCESS_KEY=xxx
# BACKUP_S3_SECRET_KEY=xxx
